# Environment Mode (development / production)
ENVIRONMENT=development
# Comma-separated list of origins allowed in production (e.g. https://app.doomott.com,https://admin.doomott.com)
CORS_ALLOWED_ORIGINS=

# Database Configuration
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/doom_ott

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# JWT Security - DO NOT COMMIT REAL SECRETS. Generate unique secret via: openssl rand -hex 32
JWT_SECRET_KEY=REPLACE_WITH_YOUR_OWN_SECRET_generate_via_openssl_rand_hex_32
JWT_ACCESS_EXPIRE_MINUTES=30
JWT_REFRESH_EXPIRE_DAYS=7

# Provider Modes (mock / real)
SMS_PROVIDER=mock
VIDEO_PROVIDER=mock
PAYMENT_PROVIDER=mock
